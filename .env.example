MAILOPS_ENV=development
MAILOPS_HOME=.mailops
MAILOPS_LOG_LEVEL=INFO
MAILOPS_REDACT_LOGS=true
MAILOPS_MODEL_PROVIDER=openai
MAILOPS_DEFAULT_PROVIDER=proton_bridge
MAILOPS_PROTON_HOST=127.0.0.1
MAILOPS_PROTON_IMAP_PORT=1143
MAILOPS_PROTON_SMTP_PORT=1025
MAILOPS_PROTON_IMAP_SECURITY=plain
MAILOPS_PROTON_USERNAME=
MAILOPS_PROTON_PASSWORD=
MAILOPS_PROTON_ACCOUNT_EMAIL=
MAILOPS_PROTON_CANONICAL_EMAIL=
MAILOPS_PROTON_CONFIG_FILE=
